# IGDB — Twitch client credentials (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OpenCritic via RapidAPI (https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api)
# Optional: without it scores are N/D. Free plan ≈ 25 searches + 200 requests per day.
RAPIDAPI_KEY=
# Per-run caps, to stay inside the daily quota.
OPENCRITIC_MAX_SEARCHES=20
OPENCRITIC_MAX_REQUESTS=150

# Contact info added to the Wikipedia User-Agent, as Wikimedia asks (URL or e-mail).
WIKI_CONTACT=
