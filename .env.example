# IGDB — Twitch client credentials (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# OpenCritic via RapidAPI (https://rapidapi.com/opencritic-opencritic-default/api/opencritic-api)
# Optional: without it scores are N/D. Free plan ≈ 25 searches + 200 requests per day.
RAPIDAPI_KEY=
# Per-run caps, to stay inside the daily quota.
OPENCRITIC_MAX_SEARCHES=20
OPENCRITIC_MAX_REQUESTS=150
# The Switch 2 catalog (~40 requests) is re-downloaded when older than this many days.
OPENCRITIC_CATALOG_DAYS=3

# Contact info added to the Wikipedia User-Agent, as Wikimedia asks (URL or e-mail).
WIKI_CONTACT=

# Metacritic (no API: the public game pages are read, 3–6 s apart).
# Requests per run (a slug with no page costs up to 3: page, search, page found);
# a game's page is due daily for 60 days after release, then weekly.
METACRITIC_MAX_REQUESTS=150
# Set to any value to skip Metacritic in data:fetch (data:fetch-metacritic ignores it).
METACRITIC_DISABLED=
